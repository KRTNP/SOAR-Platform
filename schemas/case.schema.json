{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soar-platform.local/schemas/case.schema.json",
  "title": "SOAR Case",
  "type": "object",
  "required": ["id", "tenant_id", "title", "category", "severity", "confidence", "status", "opened_at", "owner"],
  "properties": {
    "id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "category": {"type": "string"},
    "severity": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["new", "triage", "investigating", "contained", "eradication", "recovery", "escalated", "dismissed", "closed"]},
    "opened_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": "string", "format": "date-time"},
    "owner": {"type": "string"},
    "incident_commander": {"type": "string"},
    "service_owner": {"type": "string"},
    "alert_refs": {"type": "array", "items": {"type": "string"}},
    "observable_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "action_refs": {"type": "array", "items": {"type": "string"}},
    "task_refs": {"type": "array", "items": {"type": "string"}},
    "hypothesis": {"type": "string"},
    "facts": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "closure_reason": {"type": "string"},
    "correlation_key": {"type": "string"},
    "root_cause": {"type": "string"},
    "lessons_learned": {"type": "string"}
  },
  "additionalProperties": false
}
