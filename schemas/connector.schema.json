{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soar-platform.local/schemas/connector.schema.json",
  "title": "SOAR Connector Manifest",
  "type": "object",
  "required": ["id", "version", "owner", "provider", "intents", "auth", "error_classes", "health_check", "dry_run", "idempotency", "data_classification", "timeout_seconds", "retry_policy", "rate_limit", "target_allowlist"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "owner": {"type": "string"},
    "provider": {"type": "string"},
    "intents": {"type": "array", "items": {"type": "string"}},
    "auth": {"type": "object", "required": ["method", "scopes"], "properties": {"method": {"type": "string"}, "scopes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "error_classes": {"type": "array", "items": {"type": "string"}},
    "health_check": {"type": "object", "required": ["read_only", "timeout_seconds"], "properties": {"read_only": {"const": true}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}}, "additionalProperties": false},
    "dry_run": {"type": "boolean"},
    "idempotency": {"type": "boolean"},
    "data_classification": {"type": "string"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "retry_policy": {"type": "object", "required": ["max_attempts", "backoff_seconds"], "properties": {"max_attempts": {"type": "integer", "minimum": 0, "maximum": 5}, "backoff_seconds": {"type": "array", "items": {"type": "integer", "minimum": 0}}}, "additionalProperties": false},
    "rate_limit": {"type": "object", "required": ["requests_per_minute"], "properties": {"requests_per_minute": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "target_allowlist": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
