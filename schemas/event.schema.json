{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soar-platform.local/schemas/event.schema.json",
  "title": "SOAR Canonical Event",
  "type": "object",
  "required": ["id", "source", "observed_at", "received_at", "tenant_id", "event_class", "severity", "confidence", "raw_ref", "schema_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "source": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1},
    "event_class": {"type": "string", "enum": ["authentication", "network", "process", "file", "email", "vulnerability", "cloud", "malware", "other"]},
    "severity": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "observables": {"type": "array", "items": {"$ref": "observable.schema.json"}},
    "raw_ref": {"type": "object", "required": ["uri", "sha256"], "properties": {"uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": false},
    "labels": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"},
    "schema_version": {"type": "string", "pattern": "^event-[0-9]+\\.[0-9]+$"}
  },
  "additionalProperties": false
}
