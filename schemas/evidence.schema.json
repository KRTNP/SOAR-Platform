{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soar-platform.local/schemas/evidence.schema.json",
  "title": "SOAR Evidence Metadata",
  "type": "object",
  "required": ["id", "case_id", "artifact_type", "uri", "sha256", "size", "source", "acquisition_method", "collector", "collected_at", "created_at", "received_at", "timezone", "tool_name", "tool_version", "command_ref", "analyst", "purpose", "limitations", "custody_events", "sensitivity", "retention_class", "integrity_status"],
  "properties": {
    "id": {"type": "string"},
    "case_id": {"type": "string"},
    "artifact_type": {"type": "string"},
    "uri": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "size": {"type": "integer", "minimum": 0},
    "source": {"type": "string"},
    "acquisition_method": {"type": "string"},
    "collector": {"type": "string"},
    "collected_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "tool_name": {"type": "string"},
    "tool_version": {"type": "string"},
    "command_ref": {"type": "string"},
    "timezone": {"type": "string"},
    "analyst": {"type": "string"},
    "purpose": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "custody_events": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["event", "actor", "at"], "properties": {"event": {"type": "string"}, "actor": {"type": "string"}, "at": {"type": "string", "format": "date-time"}, "from_hash": {"type": "string"}, "to_hash": {"type": "string"}}, "additionalProperties": false}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "sensitivity": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
    "retention_class": {"type": "string"},
    "integrity_status": {"type": "string", "enum": ["verified", "pending", "mismatch", "unavailable"]}
  },
  "additionalProperties": false
}
